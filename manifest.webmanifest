{
  "name": "Angels Touch",
  "short_name": "Angels Touch",
  "description": "An offline music player for the songs on your device — lyrics, equalizer, sleep timer and a design that follows your album art. Developed by Nikhil.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0a0914",
  "theme_color": "#0a0914",
  "categories": ["music", "entertainment"],
  "lang": "en",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a", ".aac"],
        "audio/flac": [".flac"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/webm": [".weba", ".webm"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
